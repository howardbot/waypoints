[Unit]
Description=Waypoints: check every trip source link and rebuild the status page
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
Environment=WAYPOINTS_DIR=@BASE@
Environment=WAYPOINTS_PORT=@PORT@
ExecStart=/bin/bash @BASE@/repo/deploy/refresh.sh --links
