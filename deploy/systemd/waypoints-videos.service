[Unit]
Description=Waypoints: refresh due YouTube videos and rebuild the site
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USER@
Environment=WAYPOINTS_DIR=@BASE@
Environment=WAYPOINTS_PORT=@PORT@
ExecStart=/bin/bash @BASE@/repo/deploy/refresh.sh --videos
