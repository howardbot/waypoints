---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import Badge from '../../components/Badge.astro';
import Note from '../../components/Note.astro';
import SaveButton from '../../components/SaveButton.astro';
import { TRIPS, LABEL, VIA } from '../../data/trips.js';
import { PHOTOS } from '../../data/photos.js';
import { COORDS } from '../../data/coords.js';
import VIDEOS from '../../data/videos.json';
import { searchUrl, watchUrl, thumbUrl, keepVideos } from '../../lib/youtube.js';
import { tripMonths, monthsText } from '../../lib/season.js';
import { datesLine } from '../../lib/events.js';

export function getStaticPaths() {
  return TRIPS.map(trip => ({ params: { id: trip.id }, props: { trip } }));
}

const { trip } = Astro.props as { trip: any };
const photo = trip.image ? null : (PHOTOS as Record<string, any>)[trip.id];
const recommended: { id: string; title: string; channel: string }[] = keepVideos(trip, (VIDEOS as Record<string, any>)[trip.id]);
const chain = `${trip.get.map((m: string) => LABEL[m].toUpperCase()).join(' · ')} → ${trip.do.map((a: string) => LABEL[a].toUpperCase()).join(' · ')}`;
const coords = (COORDS as Record<string, [number, number]>)[trip.id];
const dates = datesLine(trip.id);
const glance = [
  ['Get there', trip.get.map((m: string) => LABEL[m]).join(' · ')],
  ['Best months', monthsText(tripMonths(trip, coords?.[0]))],
  ...(dates ? [['Dates', dates]] : []),
  ...(trip.glance ?? []),
];
const waysTitle = ['One way', 'Two ways', 'Three ways', 'Four ways', 'Five ways'][(trip.ways?.length ?? 1) - 1] ?? 'Ways';

// Similar trips share the most activities and ways of getting there.
const overlap = (t: any) => t.do.filter((a: string) => trip.do.includes(a)).length + t.get.filter((m: string) => trip.get.includes(m)).length;
const similar = TRIPS.filter(t => t.id !== trip.id)
  .map(t => ({ t, n: overlap(t) }))
  .sort((a, b) => b.n - a.n)
  .slice(0, 3)
  .map(x => x.t);
---
<Base title={trip.short ?? trip.title} description={trip.summary}>
  <section class="wrap page-intro">
    <nav class="crumbs" aria-label="Breadcrumb"><a class="lnk" href="/discover/">Discover</a><span aria-hidden="true">/</span><span aria-current="page">{trip.short ?? trip.title}</span></nav>
    <span class="chain-line">{chain}</span>
    <h1 class="display detail-title">{trip.title}</h1>
    <p class="muted" style="margin: 0; font-size: 17px">{trip.place} · {trip.season} · {trip.length}</p>
    {trip.summary && <p class="lead">{trip.summary}</p>}
    <div class="card callout">
      <Badge req={trip.req} />
      <Note req={trip.req} notes={trip.notes} class="callout-note" />
    </div>
    <div class="actions">
      <SaveButton id={trip.id} text="Save to wishlist" savedText="Saved to wishlist" />
      <button type="button" class="btn btn-outline js-done-open" data-trip-done={trip.id}><Icon name="check" size={16} strokeWidth={2.25} />I've done this</button>
      {coords && <a class="btn btn-outline" href={`/map/?trip=${trip.id}`}><Icon name="pin" size={16} strokeWidth={2} />On the map</a>}
      {trip.path && <a class="btn btn-primary" href="#path">See the path</a>}
    </div>
    <form class="card done-form js-done-form" hidden novalidate>
      <div class="field">
        <label for="done-date">When</label>
        <input id="done-date" class="input" type="date" required />
      </div>
      <div class="field done-note">
        <label for="done-note">Note (optional)</label>
        <input id="done-note" class="input" type="text" maxlength="200" placeholder="Who you went with, what you'd do again…" />
      </div>
      <div class="done-buttons">
        <button type="submit" class="btn btn-dark">Save to logbook</button>
        <button type="button" class="btn btn-outline js-done-cancel">Cancel</button>
      </div>
    </form>
    <p class="done-summary js-done-summary" hidden>
      <Icon name="check" size={18} strokeWidth={2.25} />
      <span><strong>Done</strong> <span class="js-done-text"></span></span>
      <button type="button" class="lnk js-done-edit">Edit</button>
      <button type="button" class="lnk js-done-remove">Remove</button>
    </p>
  </section>

  <section class="wrap detail-hero">
    <figure class="detail-photo">
      <Photo label={trip.photo ?? trip.short} tone={trip.tone} image={trip.image} photo={photo} height={440} sizes="(min-width: 1240px) 860px, 100vw" eager />
      {photo && (
        <figcaption class="credit">
          Photo: <a href={photo.page} rel="noopener">{photo.author || 'Wikimedia Commons'}</a> ·{' '}
          {photo.licenseUrl ? <a href={photo.licenseUrl} rel="license noopener">{photo.license}</a> : photo.license}, via Wikimedia Commons
        </figcaption>
      )}
    </figure>
    <aside class="card glance" aria-label="At a glance">
      <span class="eyebrow-sm">At a glance</span>
      <dl>
        {glance.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
      {trip.headsUp && (
        <div class="headsup"><Icon name="alert" size={20} strokeWidth={2} /><span>{trip.headsUp}</span></div>
      )}
    </aside>
  </section>

  {trip.ways && (
    <section class="wrap" style="padding-bottom: 88px">
      <h2 class="display h2" style="margin-bottom: 28px">{waysTitle} to get there</h2>
      <div class="grid-cards dense">
        {trip.ways.map((way: any) => (
          <article class="card way">
            <div class="way-top">
              <span class="icon-tile" style="width: 48px; height: 48px"><Icon name={way.mode} size={24} /></span>
              <Badge req={way.req} />
            </div>
            <h3 class="way-mode">{LABEL[way.mode]}</h3>
            <p class="way-title">{way.title}</p>
            <p class="way-detail">{way.detail}</p>
            <p class="way-note">For you: <Note req={way.req} notes={way.notes} class="" /></p>
          </article>
        ))}
      </div>
    </section>
  )}

  {trip.path && (
    <section id="path" class="night">
      <div class="wrap section split">
        <div class="stack" style="flex: 1 1 320px; gap: 14px">
          <span class="eyebrow">Your path</span>
          <h2 class="display h2">From first try to doing it yourself</h2>
          <p class="lead">Each step unlocks as your skills move forward in the logbook.</p>
        </div>
        <ol class="path">
          {trip.path.map((step: any, i: number) => (
            <li>
              <span class="path-num">{i + 1}</span>
              <div class="path-body">
                <span class="path-label">{step.label}</span>
                <Badge req={step.req} guided={step.guided} goal="level" />
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {trip.pack && (
    <section class="wrap" style="padding-block: 88px 40px">
      <h2 class="display h2" style="margin-bottom: 28px">Pack list</h2>
      <div class="grid-cards" style="gap: 20px">
        {trip.pack.map((group: any) => (
          <div class="card pack">
            <span class="eyebrow">{group.group}</span>
            <ul>{group.items.map((item: string) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap stack" style="padding-block: 48px 40px; gap: 24px" data-videos={trip.id}>
    <div class="stack">
      <span class="eyebrow">Inspiration</span>
      <h2 class="display h2">Watch it on YouTube</h2>
      <p class="muted" style="margin: 0">Top YouTube videos for this trip, plus live searches for more. Found one you love? Save it below; saved videos stay with this trip in this browser.</p>
    </div>
    <div class="chips">
      {(trip.youtube ?? [trip.title]).map((term: string) => (
        <a class="chip yt-chip" href={searchUrl(term)} target="_blank" rel="noopener noreferrer"><Icon name="play" size={14} fill />{term}</a>
      ))}
    </div>
    {recommended.length > 0 && (
      <div class="grid-cards" style="gap: 20px">
        {recommended.map(video => (
          <a class="video" href={watchUrl(video.id)} target="_blank" rel="noopener noreferrer">
            <span class="video-thumb"><img src={thumbUrl(video.id)} alt="" loading="lazy" /><span class="play"><Icon name="play" size={22} fill /></span></span>
            <span class="video-name">{video.title}</span>
            <span class="small muted">{video.channel}</span>
          </a>
        ))}
      </div>
    )}
    <h3 class="display" style="font-size: 26px; margin-top: 12px">Your saved videos</h3>
    <form class="add-video" novalidate>
      <div class="field">
        <label for="video-url">Video link</label>
        <input id="video-url" class="input" type="url" inputmode="url" placeholder="https://youtube.com/watch?v=…" aria-describedby="video-error" />
      </div>
      <button type="submit" class="btn btn-dark" style="border-radius: 10px">Add video</button>
    </form>
    <p class="form-error js-video-error" id="video-error" hidden>That doesn't look like a web link. Paste the full address, starting with https://</p>
    <p class="empty-row js-video-empty">No videos saved for this trip yet.</p>
    <div class="grid-cards js-video-list" style="gap: 20px"></div>
  </section>

  {trip.sources?.length > 0 && (
    <section class="wrap" style="padding-block: 48px 0">
      <h2 class="display h3" style="margin-bottom: 12px">Sources</h2>
      <p class="muted small" style="margin: 0 0 16px">
        {trip.via && `Suggested by ${VIA[trip.via as keyof typeof VIA]} research; each claim was checked against these sources. `}
        Rules, prices and seasons change, so check them before you go.
      </p>
      <ul class="sources">
        {trip.sources.map((s: { label: string; url: string }) => (
          <li><a class="lnk" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a><span class="mono small muted">{new URL(s.url).hostname.replace(/^www\./, '')}</span></li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap" style="padding-block: 48px 96px">
    <h2 class="display h3" style="margin-bottom: 20px">Similar combos</h2>
    <div class="rows">
      {similar.map(t => (
        <a class="row" href={`/trips/${t.id}/`}>
          <span class="row-main">{t.title}</span>
          <span class="row-meta">{t.place}</span>
          <Badge req={t.req} />
        </a>
      ))}
    </div>
  </section>

  <script>
    import { initTripPage } from '../../lib/trip-page.js';
    initTripPage();
  </script>
</Base>
