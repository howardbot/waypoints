---
import Base from '../layouts/Base.astro';
import TrackSteps from '../components/TrackSteps.astro';
import { TRACKS } from '../data/skills.js';
import { STATS, LOGBOOK, fmt } from '../data/logbook.js';
---
<Base title="Skills & logbook">
  <section class="wrap page-intro">
    <span class="eyebrow">Skills and logbook</span>
    <h1 class="display h1">Where I am, what's next</h1>
    <p class="lead">Tap the step you're on. The recommender uses these levels to sort trips into ready now, with a guide, and goal trips. Your levels are saved in this browser.</p>
  </section>

  <section class="wrap" style="padding-bottom: 80px">
    <div class="track-grid">
      {TRACKS.map(track => <TrackSteps track={track} interactive headingLevel={2} />)}
    </div>
  </section>

  <section class="night">
    <div class="wrap section">
      <div class="section-head">
        <div class="stack">
          <span class="eyebrow">Logbook</span>
          <h2 class="display h2">Totals by activity</h2>
        </div>
      </div>
      <div class="table-wrap" role="region" aria-label="Totals by activity" tabindex="0">
        <table class="table">
          <thead>
            <tr><th scope="col">Activity</th><th scope="col">Totals</th><th scope="col">Last entry</th></tr>
          </thead>
          <tbody>
            {LOGBOOK.map(row => (
              <tr>
                <th scope="row">{row.activity}</th>
                <td class="stat">{row.stats.map(key => `${fmt(STATS[key].value)} ${STATS[key].unit}`).join(' · ')}</td>
                <td class="last">{row.last ?? 'No entries yet'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="wrap section" id="wishlist">
    <div class="section-head">
      <div class="stack">
        <span class="eyebrow">Wishlist</span>
        <h2 class="display h2">Saved combos</h2>
      </div>
      <a class="lnk" href="/discover/">Find more →</a>
    </div>
    <div class="rows js-wishlist" hidden></div>
    <p class="empty-row js-wishlist-empty">Nothing saved yet. Tap Save on any trip in Discover.</p>
  </section>

  <script>
    import { initLogbook } from '../lib/logbook-page.js';
    initLogbook();
  </script>
</Base>
