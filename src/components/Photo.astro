---
// A trip photo: your own (`image`), the Commons one from photos.js (served from this site
// once the server has downloaded it), or a contour-line placeholder.
import Icon from './Icon.astro';
import { localize } from '../lib/local-photo.js';

interface Props {
  label: string;
  tone?: string;
  image?: string;
  photo?: { src: string; srcset?: string; alt: string };
  sizes?: string;
  height?: number;
  isNew?: boolean;
  eager?: boolean;
  class?: string;
}

const { label, tone = '#1c3346', image, photo: commons, sizes = '(min-width: 1240px) 400px, (min-width: 700px) 50vw, 100vw', height = 176, isNew = false, eager = false, class: className } = Astro.props;
const photo = localize(commons);
const src = image ?? photo?.src;
const srcset = image ? undefined : photo?.srcset || undefined;
const alt = image ? label : photo?.alt ?? label;
---
<div class:list={['photo', className]} style={`--tone:${tone};height:${height}px`}>
  {src ? (
    <img src={src} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" referrerpolicy="no-referrer" />
  ) : (
    <Fragment>
      <svg viewBox="0 0 400 176" preserveAspectRatio="none" fill="none" stroke="#ffffff" stroke-opacity="0.16" stroke-width="1.2" aria-hidden="true">
        <path vector-effect="non-scaling-stroke" d="M-10 136 C 80 106, 150 156, 240 116 S 360 76, 410 96" />
        <path vector-effect="non-scaling-stroke" d="M-10 156 C 90 126, 160 176, 250 136 S 370 96, 410 116" />
        <ellipse vector-effect="non-scaling-stroke" cx="300" cy="60" rx="90" ry="40" />
        <ellipse vector-effect="non-scaling-stroke" cx="300" cy="60" rx="55" ry="22" />
        <ellipse vector-effect="non-scaling-stroke" cx="300" cy="60" rx="22" ry="8" />
      </svg>
      <span class="photo-label">PHOTO · {label}</span>
    </Fragment>
  )}
  {isNew && <span class="new-tag"><Icon name="sparkle" size={13} strokeWidth={2} />NEW TO YOU</span>}
</div>
