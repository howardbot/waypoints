---
interface Props {
  note?: string;
}

const { note = 'Check local rules, permits and protected areas before every trip.' } = Astro.props;
---
<footer class="site-footer">
  <div class="wrap">
    <span class="footer-brand">WAYPOINTS</span>
    <span class="small muted">{note} · <a class="lnk" href="/credits/">Photo credits</a> · <a class="lnk" href="/status/">Status</a> · <span data-sync-status>Saved in this browser</span></span>
  </div>
</footer>
